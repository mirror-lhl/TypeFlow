{
  "name": "typeflow",
  "version": "0.1.0",
  "description": "TypeFlow — 全新实现的 Markdown 编辑器（Electron + ProseMirror）",
  "private": true,
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-dev.mjs dev",
    "preview": "node scripts/run-dev.mjs preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify:l0": "node scripts/verify-l0.mjs",
    "test:input-rules": "node scripts/probe-input-rules.mjs",
    "smoke": "node scripts/smoke-launch.mjs",
    "verify:all": "npm run typecheck && npm run build && npm run verify:l0 && npm run test:input-rules && npm run smoke",
    "start": "node scripts/run-dev.mjs start",
    "pack:mac": "npm run build && electron-builder --mac",
    "icons": "python3 scripts/generate-icons.py && iconutil -c icns build/icon.iconset -o build/icon.icns",
    "pack:mac:dir": "npm run build && electron-builder --mac dir --arm64",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:all": "npm run build && electron-builder --mac --win --linux",
    "pack:verify": "node scripts/package-and-verify.mjs",
    "pack:verify:zip": "node scripts/package-and-verify.mjs --zip",
    "pack:open": "node scripts/package-and-verify.mjs --open"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20.14.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.3",
    "pdfjs-dist": "^6.4.299",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.6",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "author": "TypeFlow",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
