<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 商店版强制沙箱；站外构建使用 entitlements.mac.plist，不含此键 -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Electron/Chromium 的 JIT 与运行时需要 -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- 用户经系统对话框选中的文件/文件夹可读写；其余访问走安全作用域书签 -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!--
    App 作用域书签：**持久化访问授权的必要 entitlements**。

    没有它，`dialog.showOpenDialog` 返回的 bookmarks 在下次启动时无法解析，
    `app.startAccessingSecurityScopedResource()` 会失败——表现为
    "重启后打不开最近文档 / 无法写 assets/ / 工作区目录树失效"，
    也就是 mas-access.ts 的整套授权机制形同虚设。
    沙箱里这个能力必须显式声明，不会被其它键隐含。
  -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
</dict>
</plist>
